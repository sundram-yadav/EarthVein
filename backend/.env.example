# Copy to .env for local development. On Render, set these in the dashboard instead.
SECRET_KEY=change-this-to-a-long-random-string
MONGO_URI=
MONGO_DB=earthvein
# Only needed if the frontend is hosted on a different origin than the backend.
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@earthvein.in
ADMIN_PASSWORD=Admin@12345
CONTROL_EMAIL=control@earthvein.in
CONTROL_PASSWORD=Control@12345
SEED_DEMO=true
PORT=5000
